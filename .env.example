# Copy to .env (never commit .env) and adjust for your machine / target system.

# Default target under test (new projects also default to Bing)
AUTOTEST_BASE_URL=https://www.bing.com
AUTOTEST_USERNAME=
AUTOTEST_PASSWORD=

# Optional: Web/API debug mode (npm start)
# AUTOTEST_RUN_MODE=mock

# Optional: local paths for repository scenario scanning (scripts/generate-repository-scenarios.mjs)
# AUTOTEST_BASE_FRONTEND=
# AUTOTEST_BASE_BACKEND=
# AUTOTEST_MES_FRONTEND=
# AUTOTEST_MES_BACKEND=
# AUTOTEST_WMS_FRONTEND=
# AUTOTEST_WMS_BACKEND=
# AUTOTEST_QMS_FRONTEND=
# AUTOTEST_QMS_BACKEND=
# AUTOTEST_TPM_FRONTEND=
# AUTOTEST_TPM_BACKEND=
# AUTOTEST_LEGACY_MES_FRONTEND=
# AUTOTEST_LEGACY_MES_BACKEND=

# Optional: reuse Playwright browser cache when packaging desktop
# AUTOTEST_DESKTOP_BROWSER_CACHE=
